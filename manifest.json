{
  "manifest_version": 3,
  "name": "OriginFill — Job Application Autofill",
  "short_name": "OriginFill",
  "version": "1.4.0",
  "description": "Fill Workday job applications in one click: name, contact, work history, education, résumé. Saves your answers if the session times out.",
  "author": "CharyWorld",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    },
    "default_title": "OriginFill — Auto-fill job applications"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkday.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.yello.co/*"
      ],
      "js": [
        "utils/constants.js",
        "utils/logger.js",
        "utils/dom-actions.js",
        "utils/fuzzy-match.js",
        "utils/field-mapper.js",
        "utils/faq.js",
        "content/portals/workday.js",
        "content/portals/generic.js",
        "content/detector.js",
        "content/filler.js",
        "content/observer.js",
        "content/session-guard.js",
        "content/panel.js",
        "content/init.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*"
      ],
      "js": [
        "utils/constants.js",
        "utils/logger.js",
        "utils/dom-actions.js",
        "utils/fuzzy-match.js",
        "utils/field-mapper.js",
        "utils/faq.js",
        "content/portals/workday.js",
        "content/portals/generic.js",
        "content/detector.js",
        "content/filler.js",
        "content/observer.js",
        "content/session-guard.js",
        "content/panel.js",
        "content/init.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkday.com/*",
    "*://*.myworkdaysite.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.icims.com/*",
    "*://*.taleo.net/*",
    "*://*.yello.co/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Open OriginFill popup"
    }
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "default_locale": "en"
}
